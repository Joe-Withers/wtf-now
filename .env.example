# Anthropic-compatible LLM endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Directory holding the project's OKF bundle
BUNDLE_PATH=./data/bundle

# Directory for chat sessions and pending proposals
APP_DATA_PATH=./data/app

# Private git remote that backs up the bundle. Leave empty to keep it local
BUNDLE_REMOTE=

# S3-compatible photo storage, such as Cloudflare R2 or Backblaze B2.
# Leave S3_BUCKET empty to keep photos in APP_DATA_PATH, which isn't backed up
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
